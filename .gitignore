# Build output
bin/
obj/

# Test output and failure artefacts. Runtime only, never committed.
test-results/
TestResults/
*.trx

# Reporting output (Allure is reserved, not active yet)
allure-results/

# Reqnroll writes one of these next to every .feature file at build time. They are
# generated code: never edit them, never commit them.
*.feature.cs
# Local editor and user files
*.user
.vs/
.idea/

# Agent workflow artefacts (.agents/) ARE committed on purpose. The design doc,
# implementation plan and review reports explain why this framework is shaped the
# way it is, and they are reusable as templates on the next project. They are
# documentation of the build, not build output.
#
# Before committing anything new under .agents/, check it for credentials: review
# reports quote source and configuration, so a real key could be carried in by
# accident. Placeholders such as YOUR_API_KEY_HERE only.
